 <!--
   QUERY_ALL_PACKAGES deliberately NOT declared: real, newly-discovered platform limitation found
   while building this fixture (checkpoint 3, item 24) — an APK that declares it cannot currently
   be parsed by ApkAnalyzer.analyze() via PackageManager.getPackageArchiveInfo(path, flags) on this
   device's platform version, which returns null (not an exception) for an otherwise completely
   valid archive. Verified empirically, not assumed: `aapt2 dump badging` parses the archive fine,
   and `adb install` installs it successfully — the failure is specific to parsing an *uninstalled*
   archive with this permission present. STATIC_QUERY_ALL_PACKAGES itself is unaffected and fully
   covered by unit tests (CapabilityRulesTest) against a fabricated ApkAnalysisInput; this is a gap
   in ApkAnalyzer's input acquisition, not a risk-engine defect. See V0.1_CHECKPOINT_3.md.
 -->
 <application android:label="Risk Signal Fixture" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
  <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <!-- Purely to exercise STATIC_MANY_EXPORTED_COMPONENTS (threshold: 5) — none of these do anything. -->
  <activity android:name=".NoOpActivityOne" android:exported="true"/>
  <activity android:name=".NoOpActivityTwo" android:exported="true"/>
  <receiver android:name=".NoOpReceiverOne" android:exported="true"/>
  <receiver android:name=".NoOpReceiverTwo" android:exported="true"/>
  <service android:name=".NoOpServiceNotExported" android:exported="false"/>
 </application>
</manifest>
