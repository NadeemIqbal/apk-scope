# Built application files
*.apk
*.aar
*.aab

# Files for the ART/Dalvik VM
*.dex
# ...except the Frida gadget loader, which is a checked-in asset (peer of the
# frida-gadget-*.so binaries) compiled from FridaLoaderFactory.java. Regenerate
# it with tools/build-frida-loader.sh.
!app/src/main/assets/frida_loader.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
**/build/
tools/frida-agent/node_modules/
tools/frida-agent/.build/

# Gradle files
.gradle/
buildOutput.log

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/workspace.xml

# macOS
.DS_Store

# Temporary files
*.tmp
*.bak

# Demo capture intermediate working files
demo_capture/

# Local design explorations and generated mockups
designs/

# Local execution plans and internal project state
.planning/
